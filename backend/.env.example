# ─────────────────────────────────────────────────────────────────────────────
#  LMSSI — пример переменных окружения backend.
#  Скопируйте в `.env` (`cp .env.example .env`) и заполните значения.
#  Скрипт setup.sh / setup.ps1 создаёт `.env` автоматически.
# ─────────────────────────────────────────────────────────────────────────────

# ── База данных ──────────────────────────────────────────────────────────────
# Вариант A (по умолчанию, ничего ставить не нужно) — SQLite-файл рядом с кодом:
DATABASE_URL=sqlite:///./lms.db
# Вариант B — PostgreSQL (замените USER на имя вашей роли, создайте БД `lmssi`):
# DATABASE_URL=postgresql://USER@localhost:5432/lmssi

# ── Безопасность ─────────────────────────────────────────────────────────────
# Секрет для подписи JWT. Сгенерируйте свой: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
# Время жизни токена в часах (по умолчанию 72):
# ACCESS_TOKEN_EXPIRE_HOURS=72

# ── Загрузки ─────────────────────────────────────────────────────────────────
# Каталог для загруженных файлов и сгенерированных SVG (по умолчанию uploads):
# UPLOAD_DIR=uploads

# ── ИИ-шлюз (OpenAI-совместимый, для генерации курсов и ИИ-наставника) ────────
# Без этих переменных используются значения по умолчанию из config.py.
# OPENAI_API_KEY=wf_...
# OPENAI_BASE_URL=https://api.wellflow.dev/v1
# OPENAI_MODEL=claude-sonnet-4.6
